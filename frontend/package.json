{
  "name": "scraper-strategy-studio-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "repoKind": "frontend-only",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:impact": "esbuild tests/impact-check.ts --bundle --platform=node --format=esm --alias:@=./src --outfile=node_modules/.cache/impact-check.mjs --log-level=error && node node_modules/.cache/impact-check.mjs",
    "check:render": "esbuild tests/render-smoke.tsx --bundle --platform=node --format=cjs --alias:@=./src --jsx=automatic --outfile=node_modules/.cache/render-smoke.cjs --log-level=error && node node_modules/.cache/render-smoke.cjs",
    "check": "npm run typecheck && npm run check:impact && npm run check:render"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.23.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.4.3",
    "vite": "^5.2.6"
  }
}
